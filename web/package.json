    "@radix-ui/react-dialog": "1.3.1",
    "gsap": "3.15.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "lighthouse": "13.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
