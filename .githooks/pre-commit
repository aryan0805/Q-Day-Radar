#!/bin/sh
# Blocks a commit that stages a secret. Enable once per clone: git config core.hooksPath .githooks
# (scripts/team.sh and the gate check that this is set). Needs gitleaks: brew install gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit refused" >&2
  exit 1
fi
exec gitleaks git --staged --redact --no-banner --verbose
